# Local/dev example env values
PORT=8282

DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=1234

# Optional: override with full URL instead
# DB_URL=jdbc:postgresql://localhost:5432/postgres
# JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/postgres

# Use a strong Base64-encoded secret in production
APP_JWT_SECRET=VGhpcy1pcy1hLXNhbXBsZS1iYXNlNjQtc2VjcmV0LWtleS1jaGFuZ2UtbWU=
APP_JWT_EXPIRATION_MS=86400000

# Comma-separated list/patterns
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

